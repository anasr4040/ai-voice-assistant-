# ---------------------------------------------------------------------------
# Copy to .env and fill in. Only the first block is needed to hear the bot talk.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# Speech-to-text. Free credit on signup covers a long demo.  deepgram.com
DEEPGRAM_API_KEY=

# The brain. LLM_PROVIDER picks which of the three below is used.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=google      -> GOOGLE_API_KEY, default model gemini-2.5-flash
# LLM_PROVIDER=anthropic   -> ANTHROPIC_API_KEY, default model claude-haiku-4-5
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# The voice. Swap the provider to A/B German quality on the same call flow.
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-2
# TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Phone calls (skip for the browser demo) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Where "put me through to a person" goes. Empty = take a callback instead.
TRANSFER_NUMBER=

# --- Optional ---------------------------------------------------------------
# Speech recognition language. "multi" = German + English code-switching
# (needs DEEPGRAM_MODEL=nova-3). Use "de" to lock it to German only.
STT_LANGUAGE=multi
DEEPGRAM_MODEL=nova-3

# Email captured leads to the office. Without this they are logged and shown
# on /office only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Set this and /office requires ?token=... Do set it before deploying publicly.
DASHBOARD_TOKEN=

DB_PATH=data/receptionist.db
