# ---------------------------------------------------------------------------
# Copy to .env and fill in the four keys marked REQUIRED.
# Then check everything works:  uv run python scripts/preflight.py
# ---------------------------------------------------------------------------

# --- REQUIRED: hearing ------------------------------------------------------
# Deepgram. Sign up at console.deepgram.com -- free credit on signup covers a
# demo many times over. nova-3 + multi handles German/English code-switching.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
STT_LANGUAGE=multi

# --- REQUIRED: thinking -----------------------------------------------------
# You need an LLM -- Deepgram is the ears and ElevenLabs the mouth, but without
# this there is nothing to say. Any ONE of the three below is enough.
#
# Google is the cheapest way in: aistudio.google.com/apikey gives a key with a
# free tier, no card needed, and gemini-2.5-flash is plenty for this job.
LLM_PROVIDER=google
GOOGLE_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Or OpenAI (platform.openai.com, needs prepaid credit, ~half a cent per call):
#   LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Or Anthropic (console.anthropic.com, needs prepaid credit):
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- REQUIRED: speaking -----------------------------------------------------
# This is what the owner will judge the whole thing on, so use the better voice
# for the demo. ElevenLabs German is noticeably more natural than Cartesia;
# Cartesia is ~half the price and the one to switch to once call volume is real.
# Get the voice ID from YOUR account:  uv run python scripts/list_voices.py
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# --- Phone calls (skip these for the browser demo) --------------------------
# console.twilio.com -- buy any voice-capable number. A German +49 40 number
# needs a regulatory bundle with proof of address and takes days to approve;
# any number works for the demo and can be swapped later.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Fahrschule Infinity office line. "Put me through to a person" rings here.
# E.164, no spaces -- Twilio drops the call otherwise. Spaces are stripped
# automatically, but write it correctly anyway.
TRANSFER_NUMBER=+494064421700

# --- Where captured leads go ------------------------------------------------
NOTIFY_EMAIL=Anas.rabbani.uni@gmail.com
# Without SMTP, leads are logged and shown on /office but not emailed.
# Gmail needs an App Password (not your normal password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<you>@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Set this and /office needs ?token=... Do set it before exposing the ngrok URL.
DASHBOARD_TOKEN=

# Hard ceiling on a single call, in seconds. Pipecat already hangs up after
# 300s of silence, but nothing stops a stuck line that keeps making noise, and
# every minute of that bills Deepgram and ElevenLabs. 0 disables the cap.
MAX_CALL_SECONDS=600

DB_PATH=data/receptionist.db
